<?xml version="1.0" encoding="utf-8"?>
<!--
  previewLayout del selector de widgets (Android 12+). Mismo diseño que
  widget_next_event.xml pero con texto de muestra fijo: el selector no puede
  ejecutar código, así que no hay snapshot que pintar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_accent"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_when" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/widget_fg"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_preview_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="12sp"
        android:textColor="@color/widget_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_preview_sub" />
</LinearLayout>
